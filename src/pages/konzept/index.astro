---
import site from '../../data/site.json';
const frames = [
 {image:'/media/malu.webp', name:'Malu', caption:'Draussen. Ganz bei sich.', href:'/hunde/malu/', tag:'01 — UNSERE HUNDE'},
 {image:'/media/yam.webp', name:'Yam', caption:'Ein eigener Kopf. Ein Teil von uns.', href:'/hunde/yam/', tag:'02 — UNSERE HUNDE'},
 {image:'/media/malu-portrait.webp', name:'Momente', caption:'Die kleinen Dinge bleiben.', href:'/blog/', tag:'03 — EINBLICKE'},
];
---
<!doctype html>
<html lang="de-CH"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width"/><meta name="robots" content="noindex,nofollow"/><meta name="theme-color" content="#11151d"/><meta name="description" content="Interaktiver Designentwurf für MOYO DOGS: Hunde, Menschen und Geschichten."/><title>MOYO DOGS — Bewegter Designentwurf</title><link rel="icon" href="/favicon.svg"/><link rel="preload" href="/fonts/manrope-regular.ttf" as="font" type="font/ttf" crossorigin/><link rel="preload" href="/media/malu.webp" as="image"/></head>
<body>
<a class="skip" href="#main">Zum Inhalt</a>
<header class="topbar"><a class="wordmark" href="/konzept/">moyo<span class="wordmark-star" aria-hidden="true">✳</span>dogs</a><span class="location">HOLLÄNDISCHE SCHÄFERHUNDE<br/>KANTON BERN, SCHWEIZ</span><button class="menu-toggle" aria-expanded="false" aria-controls="menu"><span>Entdecken</span><span class="menu-lines" aria-hidden="true">＋</span></button></header>
<nav id="menu" class="menu" aria-label="Hauptnavigation" hidden><a href="/hunde/">Die Hunde <span>01 ↗</span></a><a href="/zucht/">Die Zucht <span>02 ↗</span></a><a href="/wuerfe/">Die Würfe <span>03 ↗</span></a><a href="/blog/">Die Geschichten <span>04 ↗</span></a><a href="/kontakt/">Kontakt <span>05 ↗</span></a></nav>
<main id="main">
<section class="experience" aria-label="Interaktive Fotobühne">
<div class="scene">
  <div class="scene-glow" aria-hidden="true"></div>
  <div class="scene-grid" aria-hidden="true"></div>
  <div class="scene-type" aria-hidden="true">MOYO</div>
  <div class="opening"><span class="tiny">HUNDE. MENSCHEN. VERBINDUNG.</span><h1>Ein Leben.<br/><span>Zusammen.</span></h1></div>
  <div class="filmstage" aria-label="Bilder von MOYO DOGS" aria-roledescription="Karussell">
    {frames.map((frame,i)=><button type="button" class:list={['photo',i===0?'front':i===1?'next':'previous']} data-index={i} data-name={frame.name} data-href={frame.href} aria-label={`${frame.name} ansehen`} aria-pressed={i===0}>
      <img src={frame.image} alt={frame.name==='Momente'?'Malu im Porträt':`${frame.name} von MOYO DOGS`} width="1600" height="1100" loading="eager"/>
      <span class="photo-meta"><span>{frame.tag}</span><span>MOYO DOGS ↗</span></span>
    </button>)}
  </div>
  <div class="scene-side"><span class="side-line"></span><span>EIGENE WEGE.<br/>GEMEINSAM GEHEN.</span></div>
  <div class="scene-footer"><a class="featured-link" href={frames[0].href}><span class="tiny">LERNE UNS KENNEN</span><span class="featured-name">Malu <span>↗</span></span></a><div class="reel-controls"><button type="button" class="previous-button" aria-label="Vorheriges Bild">←</button><span class="counter" aria-live="polite">01 <span>/ 03</span></span><button type="button" class="next-button" aria-label="Nächstes Bild">→</button></div><a class="scroll-link" href="#geschichte">WEITERENTDECKEN <span aria-hidden="true">↓</span></a></div>
  <span class="concept-label">DESIGNSTUDIE · INTERAKTIV</span>
</div>
</section>
<section class="story" id="geschichte"><div class="story-top"><span class="tiny">01 / HALLO, WIR SIND MOYO DOGS</span><span class="tiny">MIT HERZ IM KANTON BERN</span></div><h2>Es beginnt mit einem Blick.<br/><span>Und bleibt ein Leben lang.</span></h2><div class="story-bottom"><p>{site.intro}</p><a class="round-link" href="/zucht/">Sandra & die Zucht <span>↗</span></a></div><div class="story-photo"><img src="/media/malu-portrait.webp" alt="Malu mit aufmerksamem Blick" loading="lazy" width="1500" height="1000"/><span>GANZ EIGEN. GANZ NAH.</span></div></section>
<section class="litter"><div><span class="tiny">DAS NÄCHSTE KAPITEL</span><h2>Frühling<br/>2027<span class="small-dot">.</span></h2></div><div class="litter-copy"><p>Ein letztes Mal Malu.</p><span>Eine besondere Wurfplanung, die uns am Herzen liegt.</span><a class="round-link" href="/wuerfe/fruehling-2027/">Zur Wurfplanung <span>↗</span></a></div></section>
<footer><a class="wordmark" href="/konzept/">moyo<span aria-hidden="true">✳</span>dogs</a><a href={`mailto:${site.email}`}>Lernen wir uns kennen. ↗</a><span class="tiny">KONZEPTVORSCHAU · NICHT VERÖFFENTLICHT</span></footer>
</main>
<script>
const cards=Array.from(document.querySelectorAll<HTMLButtonElement>('.photo'));
const menuButton=document.querySelector<HTMLButtonElement>('.menu-toggle');
const menu=document.querySelector<HTMLElement>('#menu');
const scene=document.querySelector<HTMLElement>('.scene');
const stage=document.querySelector<HTMLElement>('.filmstage');
const counter=document.querySelector<HTMLElement>('.counter');
const featured=document.querySelector<HTMLAnchorElement>('.featured-link');
const name=document.querySelector<HTMLElement>('.featured-name');
const motion=window.matchMedia('(prefers-reduced-motion: reduce)');
// Data attributes keep links sourced from the same content as the cards.
const entries=cards.map(card=>({name:card.dataset.name ?? '',href:card.dataset.href ?? '/hunde/'}));
let active=0;
function select(index:number){
 active=(index+cards.length)%cards.length;
 cards.forEach((card,i)=>{card.classList.toggle('front',i===active);card.classList.toggle('next',i===(active+1)%cards.length);card.classList.toggle('previous',i===(active+cards.length-1)%cards.length);card.setAttribute('aria-pressed',String(i===active));});
 if(counter)counter.innerHTML=`${String(active+1).padStart(2,'0')} <span>/ 03</span>`;
 if(featured)featured.href=entries[active].href;
 if(name)name.innerHTML=`${entries[active].name} <span>↗</span>`;
}
cards.forEach((card,i)=>card.addEventListener('click',()=>select(i)));
document.querySelector('.next-button')?.addEventListener('click',()=>select(active+1));
document.querySelector('.previous-button')?.addEventListener('click',()=>select(active-1));
stage?.addEventListener('keydown',(event:KeyboardEvent)=>{if(event.key==='ArrowRight'){event.preventDefault();select(active+1);}if(event.key==='ArrowLeft'){event.preventDefault();select(active-1);}});
menuButton?.addEventListener('click',()=>{if(!menu)return;menu.hidden=!menu.hidden;menuButton.setAttribute('aria-expanded',String(!menu.hidden));});
document.addEventListener('keydown',event=>{if(event.key==='Escape'&&menu&&!menu.hidden){menu.hidden=true;menuButton?.setAttribute('aria-expanded','false');menuButton?.focus();}});
let queued=false;
function updateScroll(){queued=false;if(!scene||motion.matches)return;const progress=Math.max(0,Math.min(1,window.scrollY/(window.innerHeight*.9)));scene.style.setProperty('--scroll',String(progress));}
window.addEventListener('scroll',()=>{if(!queued){queued=true;requestAnimationFrame(updateScroll);}},{passive:true});
scene?.addEventListener('pointermove',event=>{if(motion.matches||event.pointerType!=='mouse')return;const bounds=scene.getBoundingClientRect();scene.style.setProperty('--rx',`${(event.clientX-bounds.left)/bounds.width*2-1}`);scene.style.setProperty('--ry',`${(event.clientY-bounds.top)/bounds.height*2-1}`);});
scene?.addEventListener('pointerleave',()=>{scene.style.setProperty('--rx','0');scene.style.setProperty('--ry','0');});
motion.addEventListener('change',()=>{scene?.style.setProperty('--scroll','0');scene?.style.setProperty('--rx','0');scene?.style.setProperty('--ry','0');});
</script>
<style is:global>
@font-face{font-family:Manrope;src:url('/fonts/manrope-regular.ttf') format('truetype');font-weight:400;font-display:swap}@font-face{font-family:Manrope;src:url('/fonts/manrope-bold.ttf') format('truetype');font-weight:700;font-display:swap}
:root{--moyo-accent:#977514;font-family:Manrope,Arial,sans-serif;color:#f2f5fc;background:#11151d;color-scheme:dark;font-synthesis:none}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0}a{color:inherit;text-decoration:none}button{font:inherit;color:inherit;cursor:pointer}a:focus-visible,button:focus-visible{outline:2px solid var(--moyo-accent);outline-offset:6px}button:focus-visible{z-index:12}.skip{position:absolute;top:-100px;background:#f2f5fc;color:#222;padding:15px;z-index:100}.skip:focus{top:0}.topbar{position:absolute;top:0;left:0;right:0;z-index:30;display:flex;align-items:center;justify-content:space-between;gap:20px;padding:30px 5%}.wordmark{display:flex;align-items:center;gap:9px;font-weight:700;font-size:23px;letter-spacing:-1.4px}.wordmark-star{font-size:24px;color:var(--moyo-accent)}.location{font-size:9px;line-height:1.6;letter-spacing:.12em;text-align:center;color:#aebccc}.menu-toggle{display:flex;align-items:center;gap:23px;border:1px solid #ffffff24;border-radius:25px;padding:9px 9px 9px 20px;background:#ffffff06;font-size:11px;backdrop-filter:blur(20px)}.menu-lines{background:#f2f5fc;color:#08090b;width:29px;height:29px;display:grid;place-items:center;border-radius:50%;font-size:21px}.menu{position:absolute;right:5%;top:96px;padding:25px;background:#e8ecf2;color:#171e2b;border-radius:5px;z-index:40;width:min(420px,90%);box-shadow:0 30px 100px #0008}.menu[hidden]{display:none}.menu a{display:flex;justify-content:space-between;align-items:center;padding:17px 0;border-bottom:1px solid #171e2b30;font-size:27px;letter-spacing:-1px}.menu a span{font-size:11px;letter-spacing:0}.experience{height:145svh;min-height:900px}.scene{position:sticky;top:0;height:100svh;min-height:660px;overflow:hidden;isolation:isolate;--scroll:0;--rx:0;--ry:0;background:radial-gradient(ellipse at 50% 45%,#303743 0,#1b212c 38%,#11151d 75%)}.scene-glow{position:absolute;left:29%;top:28%;width:45%;height:55%;background:var(--moyo-accent);filter:blur(110px);opacity:.1;border-radius:50%;transform:translate(calc(var(--rx)*20px),calc(var(--ry)*20px));z-index:-1}.scene-grid{position:absolute;inset:10% 4% 6%;background:linear-gradient(90deg,transparent calc(50% - .5px),#f2f5fc08 50%,transparent calc(50% + .5px));border:1px solid #f2f5fc09;pointer-events:none}.scene-type{position:absolute;top:23%;left:50%;transform:translate(-50%,calc(var(--scroll)*-80px));font-size:clamp(130px,28vw,430px);line-height:1;letter-spacing:-.095em;font-weight:700;color:#f2f5fc12;white-space:nowrap;user-select:none}.opening{position:absolute;z-index:8;left:7%;top:26%;pointer-events:none;transform:translateY(calc(var(--scroll)*-120px));opacity:calc(1 - var(--scroll)*.6)}.tiny{display:block;font-size:9px;letter-spacing:.18em;line-height:1.7}.opening>.tiny{color:#aebccc;margin-bottom:26px}h1{font-size:clamp(44px,6.4vw,94px);font-weight:400;letter-spacing:-.065em;line-height:1.05;margin:0;max-width:650px}h1 span{color:#f2f5fc}.filmstage{position:absolute;inset:13% 0 15%;perspective:1400px;transform:translate(calc(var(--rx)*9px),calc(var(--ry)*9px - var(--scroll)*10px)) scale(calc(1 + var(--scroll)*.11));transition:transform .35s ease-out}.photo{position:absolute;display:block;overflow:hidden;width:40%;height:85%;left:46%;top:7%;padding:0;border:1px solid #f2f5fc55;border-radius:4px;background:#263442;box-shadow:0 30px 90px #0008;transform-style:preserve-3d;transition:transform .85s cubic-bezier(.22,.75,.15,1),filter .85s,opacity .85s}.photo img{width:100%;height:100%;display:block;object-fit:cover;object-position:center;pointer-events:none;filter:saturate(.7)}.photo.front{transform:translateX(0) rotateY(calc(-12deg + var(--rx)*3deg)) rotateZ(-3deg);z-index:4}.photo.next{transform:translateX(46%) translateZ(-240px) rotateY(-27deg) rotateZ(7deg);filter:brightness(.48);z-index:2}.photo.previous{transform:translateX(-43%) translateZ(-320px) rotateY(27deg) rotateZ(-10deg);filter:brightness(.35);z-index:1}.photo.front:hover{border-color:var(--moyo-accent)}.photo-meta{position:absolute;inset:auto 0 0;display:flex;justify-content:space-between;gap:10px;padding:22px 16px 14px;background:linear-gradient(transparent,#0009);font-size:8px;letter-spacing:.1em;color:#fff;text-align:left}.scene-side{position:absolute;right:4%;top:42%;writing-mode:vertical-rl;display:flex;gap:18px;align-items:center;font-size:8px;letter-spacing:.18em;color:#aebccc}.side-line{height:60px;border-left:1px solid #aebccc60}.scene-footer{position:absolute;left:7%;right:6%;bottom:7%;z-index:10;display:flex;align-items:flex-end;justify-content:space-between;gap:20px}.featured-link>.tiny{color:#aebccc;margin-bottom:10px}.featured-name{display:flex;align-items:center;gap:25px;font-size:26px;letter-spacing:-1px}.featured-name>span{font-size:20px;color:var(--moyo-accent)}.reel-controls{display:flex;align-items:center;gap:24px}.reel-controls button{border:1px solid #ffffff25;background:#ffffff05;width:42px;height:42px;border-radius:50%;font-size:19px;transition:background .2s}.reel-controls button:hover{background:var(--moyo-accent);color:#08090b}.counter{font-size:11px;font-variant-numeric:tabular-nums}.counter>span{color:#aebccc}.scroll-link{font-size:8px;letter-spacing:.1em;display:flex;gap:20px;align-items:center}.scroll-link span{font-size:23px}.concept-label{position:absolute;bottom:16px;left:7%;color:#aebccc;font-size:7px;letter-spacing:.2em}.story{background:#f1f3f7;color:#171e2b;padding:80px 7% 0;overflow:hidden}.story-top{display:flex;justify-content:space-between;gap:20px;color:#57647b}.story h2{font-size:clamp(35px,5.3vw,77px);font-weight:400;letter-spacing:-.055em;line-height:1.12;margin:90px 0 42px}.story h2>span{color:#57647b}.story-bottom{display:flex;align-items:center;justify-content:space-between;gap:50px;margin-bottom:60px}.story-bottom p{max-width:460px;font-size:14px;line-height:1.8;color:#57647b}.round-link{display:flex;gap:35px;align-items:center;font-size:12px}.round-link>span{display:grid;place-items:center;width:46px;height:46px;border:1px solid #57647b66;border-radius:50%;font-size:20px;transition:transform .3s}.round-link:hover>span{transform:rotate(45deg);background:#d9dee8}.story-photo{position:relative;height:550px;overflow:hidden}.story-photo img{width:100%;height:100%;object-fit:cover;object-position:center 40%;filter:saturate(.7)}.story-photo>span{position:absolute;bottom:35px;left:35px;color:#fff;font-size:10px;letter-spacing:.2em}.litter{padding:100px 7%;display:grid;grid-template-columns:1fr 1fr;gap:50px;align-items:center;background:var(--moyo-accent);color:#08090b}.litter h2{font-size:clamp(65px,9vw,140px);font-weight:400;letter-spacing:-.07em;line-height:1;margin:25px 0 0}.small-dot{color:#08090b}.litter-copy p{font-size:35px;letter-spacing:-1px;margin:0 0 20px}.litter-copy>span{display:block;max-width:300px;line-height:1.8;font-size:13px;color:#08090b}.litter .round-link{margin-top:40px}footer{padding:60px 7%;display:flex;align-items:center;justify-content:space-between;gap:25px;flex-wrap:wrap}footer>a:not(.wordmark){font-size:16px}footer .tiny{width:100%;color:#aebccc;margin-top:35px;font-size:8px}
@media(max-width:760px){.topbar{padding:22px 6%}.location{display:none}.wordmark{font-size:21px}.experience{height:125svh;min-height:850px}.scene{min-height:690px}.scene-type{top:30%;font-size:35vw}.opening{left:7%;top:18%}.opening>.tiny{font-size:7px;margin-bottom:15px}h1{font-size:clamp(42px,10vw,70px)}.filmstage{inset:32% 0 18%}.photo{left:22%;width:57%;height:94%;top:0}.photo.front{transform:rotateY(-10deg) rotateZ(-3deg)}.photo.next{transform:translateX(48%) translateZ(-250px) rotateY(-30deg) rotateZ(8deg)}.photo.previous{transform:translateX(-48%) translateZ(-250px) rotateY(30deg) rotateZ(-8deg)}.photo-meta{padding:20px 10px 10px;font-size:6px}.scene-side{display:none}.scene-footer{bottom:7%;align-items:center}.featured-name{font-size:22px}.featured-link>.tiny{font-size:7px}.reel-controls{gap:13px}.reel-controls button{width:44px;height:44px}.scroll-link{display:none}.story{padding-top:48px}.story-top .tiny{font-size:7px}.story-top .tiny:last-child{display:none}.story h2{margin-top:55px}.story-bottom{align-items:flex-start;flex-direction:column;gap:15px}.story-photo{height:380px}.litter{grid-template-columns:1fr;padding-block:65px;gap:30px}.litter-copy p{font-size:28px}.menu a{font-size:25px}footer{padding-block:45px}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*,*::before,*::after{transition:none!important;animation:none!important}.opening,.filmstage,.scene-type{transform:none!important;opacity:1!important}.scene-type{left:10%;font-size:24vw}.experience{height:auto;min-height:0}.scene{position:relative}}
</style>
</body></html>
