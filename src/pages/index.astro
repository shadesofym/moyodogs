---
import Base from '../layouts/Base.astro';
import MediaImage from '../components/MediaImage.astro';
import site from '../data/site.json';
import { publicDogs, publicLitters, publicOffspring, publicPosts } from '../lib-content';
const [dogs, litters, offspring, posts] = await Promise.all([publicDogs(), publicLitters(), publicOffspring(), publicPosts()]);
const planned = litters.find(entry => entry.data.status !== 'Abgeschlossen') ?? litters[0];
const finished = litters.filter(entry => entry.data.status === 'Abgeschlossen');
const latest = posts.slice(0, 4);
const plannedYear = planned?.data.period.match(/\d{4}/)?.[0] ?? '2027';
const ikValue = planned?.body?.match(/Inzuchtkoeffizient \(IK\):\s*([\d,]+)\s*%/)?.[1];
const avkValue = planned?.body?.match(/Ahnenverlustkoeffizient \(AVK\):\s*([\d,]+)\s*%/)?.[1];
const ticker = ['Charakter', 'Gesundheit', 'Arbeitsfreude', 'Holländische Schäferhunde', 'Kanton Bern'];
const dateLabel = (date?: Date) => date ? date.toLocaleDateString('de-CH', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' }) : '';
---
<Base title="Holländische Schäferhunde · Zucht im Kanton Bern">
<section class="poster-hero wrap">
  <div class="hero-colophon">
    <span>Zuchtstätte · Kanton Bern · CH</span>
    <span>SKG / FCI anerkannt</span>
    <span>Nächster Wurf · {planned?.data.period ?? `Frühling ${plannedYear}`}</span>
  </div>
  <h1>
    <span class="sr-only">MOYO DOGS – Zucht für Holländische Schäferhunde im Kanton Bern</span>
    <span aria-hidden="true">
      <span class="hero-row"><span>MOYO</span><span class="hero-row-meta">Kleine<br/><b>Zucht</b></span></span>
      <span class="hero-row"><span class="out">DOGS</span><span class="hero-row-meta">Holländische<br/>Schäferhunde</span></span>
    </span>
  </h1>
  <div class="hero-band">
    <figure class="band-big">
      <MediaImage src={site.heroImage} alt={site.heroAlt} sizes="(max-width: 940px) 100vw, 62vw" eager/>
      <figcaption>Malu · Ecyoj-Malu of Black-Golden Pearls</figcaption>
    </figure>
    <figure class="band-small">
      <MediaImage src="/media/wordpress/wp-730.webp" alt="Welpe von MOYO DOGS im Wald" sizes="(max-width: 940px) 100vw, 34vw"/>
      <figcaption>Shades of · Welpen</figcaption>
    </figure>
  </div>
  <div class="hero-bottom">
    <div data-reveal>
      <p class="hero-intro"><strong>Holländische Schäferhunde.</strong> Eine kleine, familiäre Zucht im Kanton Bern – für Hunde, die im Kopf klar, im Alltag zuverlässig und im Einsatz zuhause sind.</p>
      <div class="hero-actions">
        <a class="button" href="/hunde/">Hunde kennenlernen <span aria-hidden="true">↗</span></a>
        <a class="button ghost" href="/wuerfe/">Wurfplanung {plannedYear}</a>
      </div>
    </div>
    <div class="hero-sticker" data-reveal aria-hidden="true"><span><b>{plannedYear}</b>UNLEASHED<br/>Welpen geplant</span></div>
  </div>
</section>

<div class="ticker" aria-hidden="true">
  <div class="ticker-track">
    {[0, 1].map(() => <span>{ticker.map(word => <>{word} <i>■</i> </>)}</span>)}
  </div>
</div>

<section class="dog-index wrap" id="hunde">
  <div class="sec-label" data-reveal>
    <h2>Die Hunde</h2>
    <span class="mono">0{dogs.length} Porträts</span>
  </div>
  <div class="dog-list">
    {dogs.map((dog, index) => (
      <a class="dog-row" href={`/hunde/${dog.id}/`} data-preview={dog.data.image} data-reveal>
        <span class="no">{String(index + 1).padStart(3, '0')}</span>
        <h3>{dog.data.title}</h3>
        <span class="meta">{dog.data.meta ?? ''}</span>
        <span class="go" aria-hidden="true">↗</span>
      </a>
    ))}
    <a class="dog-row" href="/nachzucht/" data-preview={offspring[0]?.data.image ?? '/media/wordpress/wp-724.webp'} data-reveal>
      <span class="no">{String(dogs.length + 1).padStart(3, '0')}</span>
      <h3>Nachzucht</h3>
      <span class="meta">{offspring.length} Porträts · Shades of &amp; The Gods</span>
      <span class="go" aria-hidden="true">↗</span>
    </a>
  </div>
  <div class="dog-preview" data-dog-preview aria-hidden="true"><img alt="" width="520" height="650"/></div>
</section>

<section class="stats" aria-label="MOYO DOGS in Zahlen">
  <div class="wrap stats-in">
    <div class="stat" data-reveal><b data-count={offspring.length}>{offspring.length}</b><span>Nachzuchtporträts</span></div>
    <div class="stat" data-reveal><b data-count={finished.length}>{finished.length}</b><span>Würfe</span></div>
    <div class="stat" data-reveal><b data-count={Number(plannedYear)}>{plannedYear}</b><span>Nächster Wurf</span></div>
  </div>
</section>

{planned && (
  <section class="unleashed wrap" id="wurf">
    <div class="unleashed-box" data-reveal>
      <div class="unleashed-copy">
        <span class="eyebrow">Wurfplanung · {planned.data.period}</span>
        <h2>{planned.data.title}</h2>
        <p>Malus letzter Wurf. Eine bewusste Verpaarung, die zusammenführt, was zusammengehört: natürliche Stärke, Energie und ein klarer Kopf.</p>
        <div class="unleashed-pair">
          <div><b>{planned.data.mother ?? 'Mutter'}</b>Mutter</div>
          <span class="x" aria-hidden="true">×</span>
          <div><b>{planned.data.father ?? 'Vater'}</b>Vater</div>
        </div>
        <div class="unleashed-data">
          {ikValue && <span>Inzuchtkoeffizient {ikValue} %</span>}
          {avkValue && <span>Ahnenverlust {avkValue} %</span>}
          <span>Status · {planned.data.status}</span>
        </div>
        <a class="button" href={`/wuerfe/${planned.id}/`}>Zur Wurfplanung <span aria-hidden="true">↗</span></a>
      </div>
      <figure class="unleashed-poster">
        <MediaImage src="/media/wordpress/wp-1465.webp" alt={`${planned.data.title} – Poster zur Wurfplanung`} sizes="(max-width: 940px) 90vw, 40vw"/>
      </figure>
    </div>
  </section>
)}

<section class="journal-home wrap" id="journal">
  <div class="sec-label" data-reveal>
    <h2>Journal</h2>
    <span class="mono">{posts.length} Beiträge</span>
  </div>
  {latest.length ? (
    <div class="journal-grid">
      {latest.map(post => (
        <a class="journal-item" href={`/blog/${post.id}/`} data-reveal>
          <figure>
            {post.data.image
              ? <MediaImage src={post.data.image} alt={post.data.imageAlt} sizes="(max-width: 760px) 30vw, 12vw"/>
              : <span class="mono" style="display:grid;place-items:center;height:100%">MOYO</span>}
          </figure>
          <div>
            <time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  ) : (
    <div class="empty-state"><h2>Neue Geschichten folgen.</h2><p>Hier teilen wir bald neue Einblicke aus unserem Alltag.</p></div>
  )}
</section>

<section class="contact" id="kontakt">
  <div class="wrap">
    <span class="eyebrow">Kontakt · Kanton Bern</span>
    <h2 data-reveal>Lass uns<br/><span>kennenlernen.</span></h2>
    <div class="contact-grid">
      <p data-reveal>Fragen zur Rasse, zur Zucht oder zum geplanten Wurf {plannedYear}? Schreib mir – ich freue mich auf dich und deine Geschichte.</p>
      <div class="contact-links" data-reveal>
        <!--email_off--><a href={`mailto:${site.email}`}><span>E-Mail</span><span>{site.email} ↗</span></a><!--/email_off-->
        <a href="/kontakt/"><span>Kontakt</span><span>Nachricht schreiben ↗</span></a>
        <a href="/hunde/"><span>Hunde</span><span>Alle Porträts ↗</span></a>
        <a href="/rasse/"><span>Rasse</span><span>Holländischer Schäferhund ↗</span></a>
      </div>
    </div>
  </div>
</section>
</Base>
