---
import Base from '../layouts/Base.astro';
import MediaImage from '../components/MediaImage.astro';
import site from '../data/site.json';
import { publicDogs, publicLitters, publicOffspring, publicPosts } from '../lib-content';
import manifest from '../data/media.generated.json';
const [dogs, litters, offspring, posts] = await Promise.all([publicDogs(), publicLitters(), publicOffspring(), publicPosts()]);
const media = manifest as unknown as Record<string, { variants: { webp: { src: string; width: number }[] } }>;
const thumbSrc = (src?: string) => {
  if (!src) return '';
  const entry = media[src];
  if (!entry) return src;
  const webp = [...entry.variants.webp].sort((a, b) => a.width - b.width);
  return (webp.find(item => item.width >= 480) ?? webp[webp.length - 1])?.src ?? src;
};
const waNumber = site.phoneWhatsapp.replace(/\D/g, '');
const waText = 'Hallo Sandra, ich habe eine Frage zu MOYO DOGS.';
const waUrl = `https://wa.me/${waNumber}?text=${encodeURIComponent(waText)}`;
const planned = litters.find(entry => entry.data.status !== 'Abgeschlossen') ?? litters[0];
const finished = litters.filter(entry => entry.data.status === 'Abgeschlossen');
const latest = posts.slice(0, 4);
const plannedYear = planned?.data.period.match(/\d{4}/)?.[0] ?? '2027';
const ikValue = planned?.body?.match(/Inzuchtkoeffizient \(IK\):\s*([\d,]+)\s*%/)?.[1];
const avkValue = planned?.body?.match(/Ahnenverlustkoeffizient \(AVK\):\s*([\d,]+)\s*%/)?.[1];
const ticker = ['Charakter', 'Gesundheit', 'Arbeitsfreude', 'Holländische Schäferhunde', 'Kanton Bern'];
const dateLabel = (date?: Date) => date ? date.toLocaleDateString('de-CH', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' }) : '';
---
<Base title="Holländische Schäferhunde · Zucht im Kanton Bern">
<section class="poster-hero wrap">
  <div class="hero-colophon">
    <span>Zuchtstätte · Kanton Bern · CH</span>
    <span>SKG / FCI anerkannt</span>
  </div>
  <h1>
    <span class="sr-only">MOYO DOGS – Zucht für Holländische Schäferhunde im Kanton Bern</span>
    <span aria-hidden="true">
      <span class="hero-row"><span>MOYO</span><span class="hero-row-meta">Kleine<br/><b>Zucht</b></span></span>
      <span class="hero-row"><span class="out">DOGS</span><span class="hero-row-meta">Holländische<br/>Schäferhunde</span></span>
    </span>
  </h1>
  <div class="hero-cta">
    <p class="hero-cta-note"><b>Nächster Wurf</b> · {planned?.data.period ?? `Frühling ${plannedYear}`}</p>
    <div class="hero-actions">
      <a class="button" href="/kontakt/">Welpenanfrage <span aria-hidden="true">↗</span></a>
      <a class="button ghost" href={waUrl} target="_blank" rel="noopener">WhatsApp <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <div class="hero-band">
    <figure class="band-big">
      <MediaImage src={site.heroImage} alt={site.heroAlt} sizes="(max-width: 940px) 100vw, 62vw" eager/>
      <figcaption>Malu · Ecyoj-Malu of Black-Golden Pearls</figcaption>
    </figure>
    <figure class="band-small">
      <MediaImage src="/media/wordpress/wp-730.webp" alt="Welpe von MOYO DOGS im Wald" sizes="(max-width: 940px) 100vw, 34vw"/>
      <figcaption>Shades of · Welpen</figcaption>
    </figure>
  </div>
  <div class="hero-bottom">
    <div data-reveal>
      <p class="hero-intro"><strong>Holländische Schäferhunde.</strong> Eine kleine, familiäre Zucht im Kanton Bern – für Hunde, die im Kopf klar, im Alltag zuverlässig und im Einsatz zuhause sind.</p>
      <a class="text-link hero-more" href="/hunde/">Hunde kennenlernen <span aria-hidden="true">↗</span></a>
    </div>
    <div class="hero-sticker" data-reveal aria-hidden="true"><span><b>{plannedYear}</b>UNLEASHED<br/>Welpen geplant</span></div>
  </div>
</section>

<div class="ticker" aria-hidden="true">
  <div class="ticker-track">
    {[0, 1].map(() => <span>{ticker.map(word => <>{word} <i>■</i> </>)}</span>)}
  </div>
</div>

<section class="dog-index wrap" id="hunde">
  <div class="sec-label" data-reveal>
    <h2>Die Hunde</h2>
    <span class="mono">0{dogs.length} Porträts</span>
  </div>
  <div class="dog-list">
    {dogs.map((dog, index) => (
      <a class="dog-row" href={`/hunde/${dog.id}/`} data-preview={dog.data.image} data-reveal>
        <span class="no">{String(index + 1).padStart(3, '0')}</span>
        <span class="dog-thumb" aria-hidden="true"><img src={thumbSrc(dog.data.image)} alt="" width="120" height="150" loading="lazy" decoding="async"/></span>
        <h3>{dog.data.title}</h3>
        <span class="meta">{dog.data.meta ?? ''}</span>
        <span class="go" aria-hidden="true">↗</span>
      </a>
    ))}
    <a class="dog-row" href="/nachzucht/" data-preview={offspring[0]?.data.image ?? '/media/wordpress/wp-724.webp'} data-reveal>
      <span class="no">{String(dogs.length + 1).padStart(3, '0')}</span>
      <span class="dog-thumb" aria-hidden="true"><img src={thumbSrc('/media/wordpress/wp-724.webp')} alt="" width="120" height="150" loading="lazy" decoding="async"/></span>
      <h3>Nachzucht</h3>
      <span class="meta">{offspring.length} Porträts · Shades of &amp; The Gods</span>
      <span class="go" aria-hidden="true">↗</span>
    </a>
  </div>
  <div class="dog-preview" data-dog-preview aria-hidden="true"><img alt="" width="520" height="650"/></div>
</section>

<section class="stats" aria-label="MOYO DOGS in Zahlen">
  <div class="wrap stats-in">
    <div class="stat" data-reveal><b data-count={offspring.length}>{offspring.length}</b><span>Nachzuchtporträts</span></div>
    <div class="stat" data-reveal><b data-count={finished.length}>{finished.length}</b><span>Würfe</span></div>
    <div class="stat" data-reveal><b data-count={Number(plannedYear)}>{plannedYear}</b><span>Nächster Wurf</span></div>
  </div>
</section>

<section class="proof" aria-labelledby="proof-title">
  <h2 id="proof-title" class="sr-only">Gesundheit und Aufzucht</h2>
  <ul class="wrap proof-in">
    <li data-reveal><b>HD A–B · ED 0 · LÜW 0</b><span>Alle Zuchthunde untersucht</span></li>
    <li data-reveal><b>DM N/N</b><span>Gentest frei</span></li>
    <li data-reveal><b>SDCA 1 &amp; 2</b><span>Augen frei</span></li>
    <li data-reveal><b>Wohnzimmer</b><span>Welpen wachsen im Haus auf</span></li>
  </ul>
</section>

{planned && (
  <section class="unleashed wrap" id="wurf">
    <div class="unleashed-box" data-reveal>
      <div class="unleashed-copy">
        <span class="eyebrow">Wurfplanung · {planned.data.period}</span>
        <h2>{planned.data.title}</h2>
        <p>Malus letzter Wurf. Eine bewusste Verpaarung, die zusammenführt, was zusammengehört: natürliche Stärke, Energie und ein klarer Kopf.</p>
        <div class="unleashed-pair">
          <div><b>{planned.data.mother ?? 'Mutter'}</b>Mutter</div>
          <span class="x" aria-hidden="true">×</span>
          <div><b>{planned.data.father ?? 'Vater'}</b>Vater</div>
        </div>
        <div class="unleashed-data">
          {ikValue && <span>Inzuchtkoeffizient {ikValue} %</span>}
          {avkValue && <span>Ahnenverlust {avkValue} %</span>}
          <span>Status · {planned.data.status}</span>
        </div>
        <a class="button" href={`/wuerfe/${planned.id}/`}>Zur Wurfplanung <span aria-hidden="true">↗</span></a>
      </div>
      <figure class="unleashed-poster">
        <MediaImage src="/media/wordpress/wp-1465.webp" alt={`${planned.data.title} – Poster zur Wurfplanung`} sizes="(max-width: 940px) 90vw, 40vw"/>
      </figure>
    </div>
  </section>
)}

<section class="steps wrap" id="ablauf">
  <div class="sec-label" data-reveal>
    <h2>Der Weg zum Welpen</h2>
    <span class="mono">04 Schritte</span>
  </div>
  <ol class="steps-grid">
    <li data-reveal>
      <span class="steps-no">01</span>
      <h3>Kennenlernen</h3>
      <p>Du schreibst mir, wir sprechen über deinen Alltag, deine Erfahrung und deine Erwartungen.</p>
    </li>
    <li data-reveal>
      <span class="steps-no">02</span>
      <h3>Besuch</h3>
      <p>Wenn es für beide Seiten passt, lernst du uns, den Hof und unsere Hunde persönlich kennen.</p>
    </li>
    <li data-reveal>
      <span class="steps-no">03</span>
      <h3>Wurf</h3>
      <p>Die Welpen wachsen im Wohnzimmer auf. Du bekommst Fotos, Updates und Einblicke in ihre Entwicklung.</p>
    </li>
    <li data-reveal>
      <span class="steps-no">04</span>
      <h3>Übergabe</h3>
      <p>Frühestens mit acht Wochen ziehen die Welpen um – geimpft, gechipt und mit Stammbaum.</p>
    </li>
  </ol>
  <p class="steps-cta" data-reveal>Interesse am Wurf {plannedYear}? <a class="text-link" href="/kontakt/">Schreib mir <span aria-hidden="true">↗</span></a></p>
</section>

<section class="faq wrap" id="fragen">
  <div class="sec-label" data-reveal>
    <h2>Häufige Fragen</h2>
    <span class="mono">Abgabe &amp; Ausland</span>
  </div>
  <div class="faq-list">
    <details class="faq-item" data-reveal>
      <summary>Ab wann ziehen die Welpen um?</summary>
      <div class="faq-body">
        <p>Frühestens mit acht Wochen. Die Schweizer Tierschutzverordnung erlaubt die Trennung von der Mutter nicht vor 56 Tagen. Wenn ein Welpe zu dir kommt, ist er geimpft, gechipt und hat seinen Stammbaum dabei.</p>
      </div>
    </details>
    <details class="faq-item" data-reveal>
      <summary>Kann ich einen Welpen ins Ausland mitnehmen?</summary>
      <div class="faq-body">
        <p>Wer den Welpen in der Schweiz abholt, braucht keine weiteren Papiere. Für Deutschland, Österreich, Frankreich und Italien gilt EU-Recht: Der Welpe braucht einen Mikrochip, eine Tollwutimpfung und einen EU-Heimtierausweis. Die Impfung ist frühestens mit zwölf Wochen möglich und gilt 21 Tage später – der Welpe kann also frühestens mit rund 15 Wochen reisen. Deutschland lässt Hunde unter 15 Wochen gar nicht einreisen.</p>
        <p>Für andere Länder gelten die Bestimmungen des jeweiligen Landes. Sag mir früh genug Bescheid, damit wir die Papiere rechtzeitig vorbereiten können.</p>
      </div>
    </details>
    <details class="faq-item" data-reveal>
      <summary>Wer entscheidet, welcher Welpe zu wem kommt?</summary>
      <div class="faq-body">
        <p>Die Entscheidung liegt bei mir als Züchterin. Nach unseren Gesprächen und dem Kennenlernen weiss ich, welcher Welpe von seinem Charakter und Temperament zu welchem Menschen passt. Deine Wünsche und Vorstellungen zählen dabei – die endgültige Wahl treffe ich.</p>
      </div>
    </details>
  </div>
  <p class="faq-cta" data-reveal>Deine Frage ist nicht dabei? <a class="text-link" href="/kontakt/">Schreib mir <span aria-hidden="true">↗</span></a></p>
</section>

<section class="portrait-home wrap" id="sandra" aria-labelledby="sandra-label">
  <div class="sec-label" data-reveal>
    <h2 id="sandra-label">Die Züchterin</h2>
    <span class="mono">Sandra · Kanton Bern</span>
  </div>
  <div class="portrait-home-grid">
    <figure class="portrait-home-photo" data-reveal>
      <MediaImage src="/media/sandra.jpg" alt="Sandra mit ihren Hunden Malu und Yam" sizes="(max-width: 940px) 92vw, 37vw"/>
    </figure>
    <div class="portrait-home-copy" data-reveal>
      <h3>Ich bin Sandra<span class="dot">.</span></h3>
      <p>Hier stehe ich mit Malu und Yam – Mutter und Sohn und der Kern meiner Zucht. Im Kanton Bern führe ich eine kleine, familiäre und SKG-/FCI-anerkannte Zucht für Holländische Schäferhunde.</p>
      <p>Wir leben auf einem älteren Bauernhof in ländlicher Umgebung. Die Welpen werden im Wohnzimmer geboren und sind von Anfang an Teil unseres Alltags.</p>
      <blockquote>Mir ist wichtig, dass am Ende nicht nur der Mensch den passenden Welpen findet, sondern auch der Welpe den passenden Menschen.</blockquote>
      <div class="portrait-home-links">
        <a class="text-link" href="/zucht/">Mehr über die Zucht <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={site.instagram} target="_blank" rel="noopener">Instagram <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>
</section>

<section class="journal-home wrap" id="journal">
  <div class="sec-label" data-reveal>
    <h2>Journal</h2>
    <span class="mono">{posts.length} Beiträge</span>
  </div>
  {latest.length ? (
    <div class="journal-grid">
      {latest.map(post => (
        <a class="journal-item" href={`/blog/${post.id}/`} data-reveal>
          <figure>
            {post.data.image
              ? <MediaImage src={post.data.image} alt={post.data.imageAlt} sizes="(max-width: 760px) 30vw, 12vw"/>
              : <span class="mono" style="display:grid;place-items:center;height:100%">MOYO</span>}
          </figure>
          <div>
            <time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  ) : (
    <div class="empty-state"><h2>Neue Geschichten folgen.</h2><p>Hier teilen wir bald neue Einblicke aus unserem Alltag.</p></div>
  )}
</section>

<section class="contact" id="kontakt">
  <div class="wrap">
    <span class="eyebrow">Kontakt · Kanton Bern</span>
    <h2 data-reveal>Lass uns<br/><span>kennenlernen.</span></h2>
    <div class="contact-grid">
      <p data-reveal>Fragen zur Rasse, zur Zucht oder zum geplanten Wurf {plannedYear}? Schreib mir – ich freue mich auf dich und deine Geschichte.</p>
      <div class="contact-links" data-reveal>
        <!--email_off--><a href={`mailto:${site.email}`}><span>E-Mail</span><span>{site.email} ↗</span></a><!--/email_off-->
        <a href={waUrl} target="_blank" rel="noopener"><span>WhatsApp</span><span>Chat öffnen ↗</span></a>
        <a href="/kontakt/"><span>Kontakt</span><span>Nachricht schreiben ↗</span></a>
        <a href="/hunde/"><span>Hunde</span><span>Alle Porträts ↗</span></a>
        <a href="/rasse/"><span>Rasse</span><span>Holländischer Schäferhund ↗</span></a>
      </div>
    </div>
  </div>
</section>
</Base>
