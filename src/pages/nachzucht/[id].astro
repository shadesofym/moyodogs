---
import {render} from 'astro:content';
import Base from '../../layouts/Base.astro';
import MediaImage from '../../components/MediaImage.astro';
import Gallery from '../../components/Gallery.astro';
import ContentBlocks from '../../components/ContentBlocks.astro';
import {publicOffspring} from '../../lib-content';
export async function getStaticPaths(){return (await publicOffspring()).map(entry=>({params:{id:entry.id},props:{entry}}));}
const {entry}=Astro.props;
const {Content}=await render(entry);
const litterName=entry.data.litter==='shades-of'?'Shades of':'The Gods';
---
<Base title={entry.data.title} description={entry.data.description} image={entry.data.image} imageAlt={entry.data.imageAlt}>
 <header class="page-heading wrap"><a class="breadcrumb" href={`/wuerfe/${entry.data.litter}/`}>← {litterName}</a><span class="eyebrow">Unsere Nachzucht</span><h1>{entry.data.title}</h1><p>{entry.data.description}</p></header>
 {entry.data.image&&<div class="wrap post-image"><MediaImage src={entry.data.image} alt={entry.data.imageAlt} eager sizes="(max-width: 760px) 100vw, 80vw"/></div>}
 <article class="prose wrap section"><Content/></article>
 <ContentBlocks blocks={entry.data.blocks}/><Gallery images={entry.data.gallery}/>
 <div class="wrap post-end"><a class="text-link" href={`/wuerfe/${entry.data.litter}/`}>Alle Hunde dieses Wurfs ↗</a></div>
</Base>
