---
import Base from '../../layouts/Base.astro';
import '../../styles/nachzucht-filter.css';
import { allPublicDogs, publicLitters, publicOffspring } from '../../lib-content';
import { canonicalUrl } from '../../lib/seo';

const offspring = await publicOffspring();
const litters = await publicLitters();
const dogs = new Map((await allPublicDogs()).map(entry => [entry.id, entry]));

const shortName = (title: string) => title.replace(/^(Shades of|The Gods)\s+/i, '');
const yearOf = (period: string) => period.match(/\d{4}/)?.[0] ?? '';

const groups = litters
  .filter(litter => offspring.some(entry => entry.data.litter === litter.id))
  .map(litter => {
    const entries = offspring.filter(entry => entry.data.litter === litter.id);
    return {
      id: litter.id,
      title: litter.data.title,
      year: yearOf(litter.data.period),
      period: litter.data.period,
      entries,
    };
  })
  .sort((a, b) => a.year.localeCompare(b.year));

let counter = 0;
const rows = groups.map(group => ({
  ...group,
  entries: group.entries.map(entry => {
    counter += 1;
    const dog = entry.data.dog ? dogs.get(entry.data.dog) : undefined;
    return {
      id: entry.id,
      no: String(counter).padStart(3, '0'),
      name: shortName(entry.data.title),
      image: entry.data.image,
      angekoert: dog?.data.angekoert ?? false,
      year: group.year,
    };
  }),
}));

const total = offspring.length;
const angekoertCount = rows.flatMap(group => group.entries).filter(entry => entry.angekoert).length;
const offspringList = {
  '@type': 'ItemList',
  '@id': `${canonicalUrl('/nachzucht/')}#nachzucht`,
  name: 'Nachzucht',
  numberOfItems: total,
  itemListElement: rows.flatMap(group => group.entries).map(entry => ({
    '@type': 'ListItem',
    position: Number(entry.no),
    name: entry.name,
    url: canonicalUrl(`/nachzucht/${entry.id}/`),
  })),
};
---
<Base title="Nachzucht aus zwei Würfen" description="Alle Hunde aus den Würfen von MOYO DOGS: Porträts, Abstammung und Entwicklung der Nachzucht im Kanton Bern." extraJsonLd={[offspringList]}>
  <section class="page-heading wrap">
    <span class="eyebrow">Aus unseren Würfen</span>
    <h1>Nachzucht<span class="dot">.</span></h1>
    <p>{total} Hunde aus zwei Würfen.{angekoertCount > 0 && ` ${angekoertCount} davon haben die Ankörung bestanden und stehen als Deckrüden zur Verfügung.`}</p>
  </section>

  <section class="wrap nachzucht-filter" aria-label="Nachzucht nach Wurf filtern" data-nachzucht-filter>
    <div class="nachzucht-filter-controls" role="group" aria-label="Wurf auswählen">
      <span class="mono nachzucht-filter-label">Schneller filtern:</span>
      <button type="button" data-nachzucht-filter-button data-litter="all" aria-pressed="true">Alle</button>
      {rows.map(group => (
        <button type="button" data-nachzucht-filter-button data-litter={group.id} aria-pressed="false">{group.title} · {group.year}</button>
      ))}
    </div>
    <p class="mono nachzucht-filter-count" data-nachzucht-filter-count aria-live="polite" aria-atomic="true">{total} Einträge</p>
  </section>

  {rows.map(group => (
    <section class="section wrap litter-group" data-nachzucht-group data-litter={group.id} data-litter-count={group.entries.length}>
      <div class="sec-label">
        <h2>{group.title}</h2>
        <span class="mono">{group.year} · {group.entries.length} Hunde</span>
      </div>
      <div class="dog-list">
        {group.entries.map(entry => (
          <a class="dog-row" href={`/nachzucht/${entry.id}/`} data-preview={entry.image} data-reveal>
            <span class="no">{entry.no}</span>
            <h3>{entry.name}</h3>
            {entry.angekoert
              ? <span class="meta meta--angekoert">Angekört · Deckrüde</span>
              : <span class="meta">Wurf {entry.year}</span>}
            <span class="go" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
      <div class="dog-preview" data-dog-preview aria-hidden="true"><img src={group.entries[0]?.image} alt="" width="520" height="650"/></div>
    </section>
  ))}

  <script>import '../../scripts/nachzucht-filter';</script>

  <section class="section wrap">
    <div class="note-band" data-reveal>
      <b>Ankörung</b>
      <span>Die Ankörung erfolgt beim Schweizerischen Club für Holländische Schäferhunde (SCHS). Details zu Gesundheit und Prüfungen stehen auf jedem Porträt.</span>
    </div>
  </section>
</Base>
