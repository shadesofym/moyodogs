---
import '../styles/fonts.css';
import '../styles/journal.css';
import '../styles/neo.css';
import {ClientRouter} from 'astro:transitions';
import site from '../data/site.json';
import EmailLink from '../components/EmailLink.astro';
import manifest from '../data/media.generated.json';
import {canonicalUrl,excludedFromSearch,indexingEnabled,jsonLd,siteOrigin} from '../lib/seo';
interface Props { title: string; description?: string; image?:string; imageAlt?:string; article?:boolean; date?:Date; noindex?:boolean; extraJsonLd?:Record<string,unknown>[]; preloadImage?:string; preloadSizes?:string }
const { title, description = site.intro, image=site.socialImage ?? site.heroImage, imageAlt=site.heroAlt, article=false, date, noindex=false, extraJsonLd=[], preloadImage, preloadSizes='(max-width: 940px) 100vw, 62vw' } = Astro.props;
const preloadEntry=preloadImage?(manifest as Record<string,{variants:Record<string,{src:string;width:number}[]>}>)[preloadImage]:undefined;
const preloadSrcset=(format:string)=>preloadEntry?.variants?.[format]?.map(v=>`${v.src} ${v.width}w`).join(', ');
const pathname = Astro.url.pathname;
const preview=!indexingEnabled(import.meta.env.SITE_INDEXING,import.meta.env.CF_PAGES_BRANCH);
const excluded=excludedFromSearch(pathname)||noindex;
const canonical=canonicalUrl(pathname);
const socialImage=new URL(image,siteOrigin).href;
const socialCard=image===site.socialImage;
const socialAlt=socialCard?(site.socialImageAlt??imageAlt):imageAlt;
const fullTitle=`${title} | ${site.name}`;
const founderId=`${siteOrigin}/#sandra`;
const founder={'@type':'Person','@id':founderId,name:site.owner,url:`${siteOrigin}/zucht/`,jobTitle:'Züchterin',worksFor:{'@id':`${siteOrigin}/#organisation`}};
const organisation={'@type':'Organization','@id':`${siteOrigin}/#organisation`,name:site.name,url:siteOrigin,email:site.email,telephone:site.phone,logo:{'@type':'ImageObject',url:`${siteOrigin}/media/logo-original.jpg`,width:1300,height:500},image:socialImage,address:{'@type':'PostalAddress',postalCode:site.postalCode,addressLocality:site.city,addressCountry:'CH'},founder:{'@id':founderId},sameAs:[site.instagram,site.facebook].filter(Boolean),areaServed:{'@type':'Country',name:'Schweiz'},knowsAbout:['Holländische Schäferhunde','Hundezucht','Aufzucht','Ankörung','SKG / FCI']};
const website={'@type':'WebSite','@id':`${siteOrigin}/#website`,name:site.name,url:siteOrigin,inLanguage:'de-CH',publisher:{'@id':`${siteOrigin}/#organisation`}};
const page={'@type':article?'BlogPosting':'WebPage','@id':`${canonical}#page`,url:canonical,name:title,headline:title,description,inLanguage:'de-CH',isPartOf:{'@id':`${siteOrigin}/#website`},image:socialImage,...(article&&date?{datePublished:date.toISOString(),author:{'@id':founderId},publisher:{'@id':`${siteOrigin}/#organisation`},mainEntityOfPage:canonical}:{})};
const breadcrumbs=pathname==='/'?null:{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'MOYO DOGS',item:siteOrigin+'/'},{'@type':'ListItem',position:2,name:title,item:canonical}]};
const structured={'@context':'https://schema.org','@graph':[organisation,founder,website,page,...(breadcrumbs?[breadcrumbs]:[]),...extraJsonLd]};
const links = [['/hunde/', 'Hunde'], ['/wuerfe/', 'Würfe'], ['/nachzucht/', 'Nachzucht'], ['/kontakt/', 'Kontakt']];
const active=(href:string)=>pathname.startsWith(href);
---
<!doctype html>
<html lang="de-CH">
<head>
  <ClientRouter /><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title><meta name="description" content={description} />
  <meta name="robots" content={preview||excluded?'noindex, follow':'index, follow, max-image-preview:large'} />
  <link rel="canonical" href={canonical}/>
  <meta name="theme-color" content="#efece3" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preload" href="/fonts/bricolage-grotesque-latin.woff2" as="font" type="font/woff2" crossorigin/>
  {preloadSrcset('avif') && <link rel="preload" as="image" type="image/avif" imagesrcset={preloadSrcset('avif')} imagesizes={preloadSizes} fetchpriority="high"/>}
  <meta property="og:title" content={fullTitle} /><meta property="og:description" content={description} />
  <meta property="og:type" content={article?'article':'website'} /><meta property="og:url" content={canonical}/>
  <meta property="og:site_name" content={site.name}/><meta property="og:locale" content="de_CH"/>
  <meta property="og:image" content={socialImage}/><meta property="og:image:alt" content={socialAlt}/>
  {socialCard&&<><meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/><meta property="og:image:type" content="image/jpeg"/></>}
  <meta name="twitter:card" content="summary_large_image"/>
  <meta name="twitter:image" content={socialImage}/><meta name="twitter:image:alt" content={socialAlt}/>
  <meta name="twitter:title" content={fullTitle}/><meta name="twitter:description" content={description}/>
  {!excluded&&<script type="application/ld+json" set:html={jsonLd(structured)}/>}
</head>
<body>
<a class="skip" href="#inhalt">Zum Inhalt</a>
<div class="scroll-progress" aria-hidden="true"><span data-progress></span></div>
{preview&&<div class="preview-note">VORSCHAU · Die neue Website entsteht. Inhalte werden noch ergänzt.</div>}
<header class="site-header">
  <a href="/" class="brand" aria-label="MOYO DOGS Startseite">{site.name}</a>
  <nav class="desktop-nav" aria-label="Hauptnavigation">
    {links.map(([href, label]) => <a href={href} aria-current={active(href) ? 'page' : undefined}>{label}</a>)}
  </nav>
  <div class="header-actions">
    <a class="header-search" href="/suche/" aria-label="Website durchsuchen" aria-current={pathname==='/suche/' ? 'page' : undefined}>
      <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="10.8" cy="10.8" r="6.2"></circle><path d="m15.5 15.5 5 5"></path></svg>
    </a>
    <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="site-menu">Menü <span class="menu-toggle-lines" aria-hidden="true"></span></button>
  </div>
</header>
<nav class="site-menu" id="site-menu" aria-label="Hauptnavigation" data-menu data-open="false" inert>
  <button class="site-menu-close" type="button" data-menu-close>Schliessen ✕</button>
  <div class="site-menu-scroll">
    <a href="/hunde/">Hunde <span>01</span></a>
    <a href="/hunde/#deckrueden">Deckrüden <span>02</span></a>
    <a href="/wuerfe/">Würfe <span>03</span></a>
    <a href="/nachzucht/">Nachzucht <span>04</span></a>
    <a href="/zucht/">Zucht <span>05</span></a>
    <a href="/rasse/">Rasse <span>06</span></a>
    <a href="/blog/">Journal <span>07</span></a>
    <a href="/kontakt/">Kontakt <span>08</span></a>
    <div class="site-menu-foot"><span>Kanton Bern · Schweiz</span><EmailLink/></div>
  </div>
</nav>
<main id="inhalt" tabindex="-1"><slot /></main>
<footer class="site-footer">
  <div class="wrap footer-top">
    <div><a class="footer-brand" href="/">{site.name}</a><p>Holländische Schäferhunde.<br/>Ein Teil unseres Lebens.</p></div>
    <div><span class="eyebrow">Lernen wir uns kennen</span><EmailLink class="email-link" suffix=" ↗"/>
      <div class="footer-social">
        <a href={site.instagram} target="_blank" rel="noopener">Instagram <span aria-hidden="true">↗</span></a>
        <a href={site.facebook} target="_blank" rel="noopener">Facebook <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </div>
  <div class="wrap footer-bottom">
    <span>© {new Date().getUTCFullYear()} MOYO DOGS · Kanton Bern</span>
    <nav aria-label="Weitere Informationen"><a href="/rasse/">Die Rasse</a><a href="/impressum/">Impressum</a><a href="/datenschutz/">Datenschutz</a></nav>
  </div>
</footer>
<script>import '../scripts/site';</script>
</body>
</html>
