---
import MediaImage from './MediaImage.astro';
import site from '../data/site.json';
interface Props { frames: {image:string;alt:string;name:string;href:string}[] }
const {frames}=Astro.props;
const headlineLines=site.headline.split('\n');
---
<moyo-stage><section class="experience" aria-label="Interaktive Fotobühne">
<div class="scene">
  <div class="scene-glow" aria-hidden="true"></div>
  <div class="scene-grid" aria-hidden="true"></div>
  <div class="scene-type" aria-hidden="true">MOYO</div>
  <div class="opening"><span class="tiny">{site.eyebrow}</span><h1>{headlineLines.map((line,i)=><>{i>0&&<br/>}{line}</>)}</h1></div>
  <div class="filmstage" aria-label="Bilder von MOYO DOGS" aria-roledescription="Karussell">
    {frames.map((frame,i)=><button type="button" class:list={['photo',i===0?'front':i===1?'next':'previous']} data-index={i} data-name={frame.name} data-href={frame.href} aria-label={`${frame.name} ansehen`} aria-pressed={i===0}>
      <MediaImage src={frame.image} alt={frame.alt} eager sizes="(max-width: 760px) 65vw, 50vw"/>
      <span class="photo-meta"><span>{String(i+1).padStart(2,'0')} — {frame.name.toUpperCase()}</span><span>{site.name} ↗</span></span>
    </button>)}
  </div>
  <div class="scene-side"><span class="side-line"></span><span>EIGENE WEGE.<br/>GEMEINSAM GEHEN.</span></div>
  <div class="scene-footer"><a class="featured-link" href={frames[0].href}><span class="tiny">LERNE UNS KENNEN</span><span class="featured-name">{frames[0].name} <span>↗</span></span></a><div class="reel-controls"><button type="button" class="previous-button" aria-label="Vorheriges Bild" disabled={frames.length<2}>←</button><span class="counter" aria-live="polite">01 <span>/ {String(frames.length).padStart(2,'0')}</span></span><button type="button" class="next-button" aria-label="Nächstes Bild" disabled={frames.length<2}>→</button></div><a class="scroll-link" href="#unsere-geschichte">WEITERENTDECKEN <span aria-hidden="true">↓</span></a></div>
  <span class="concept-label">MOYO DOGS · HOLLÄNDISCHE SCHÄFERHUNDE</span>
</div>
</section></moyo-stage>
<script>
class MoyoStage extends HTMLElement{
 private cleanup?:AbortController;
 connectedCallback(){
 this.cleanup?.abort();this.cleanup=new AbortController();const {signal}=this.cleanup;
 const cards=Array.from(this.querySelectorAll<HTMLButtonElement>('.photo'));const scene=this.querySelector<HTMLElement>('.scene');const stage=this.querySelector<HTMLElement>('.filmstage');const name=this.querySelector('.featured-name');const featured=this.querySelector<HTMLAnchorElement>('.featured-link');const counter=this.querySelector('.counter');const reduced=window.matchMedia('(prefers-reduced-motion: reduce)');let active=0;let frame=0;
 const select=(index:number)=>{active=(index+cards.length)%cards.length;cards.forEach((card,i)=>{card.classList.toggle('front',i===active);card.classList.toggle('next',i===(active+1)%cards.length);card.classList.toggle('previous',i===(active+cards.length-1)%cards.length);card.setAttribute('aria-pressed',String(i===active));});if(name){name.replaceChildren(document.createTextNode((cards[active].dataset.name??'')+' ↗'));}if(featured)featured.href=cards[active].dataset.href??'/hunde/';if(counter)counter.textContent=`${String(active+1).padStart(2,'0')} / ${String(cards.length).padStart(2,'0')}`;};
 cards.forEach((card,i)=>card.addEventListener('click',()=>select(i),{signal}));this.querySelector('.next-button')?.addEventListener('click',()=>select(active+1),{signal});this.querySelector('.previous-button')?.addEventListener('click',()=>select(active-1),{signal});stage?.addEventListener('keydown',event=>{if(event.key==='ArrowLeft'){event.preventDefault();select(active-1);}if(event.key==='ArrowRight'){event.preventDefault();select(active+1);}},{signal});
 const scroll=()=>{frame=0;if(!scene||reduced.matches)return;const progress=Math.max(0,Math.min(1,-this.getBoundingClientRect().top/(window.innerHeight*.9)));scene.style.setProperty('--scroll',String(progress));};
 window.addEventListener('scroll',()=>{if(!frame)frame=requestAnimationFrame(scroll);},{signal,passive:true});scroll();
 scene?.addEventListener('pointermove',event=>{if(reduced.matches||event.pointerType!=='mouse')return;const box=scene.getBoundingClientRect();scene.style.setProperty('--rx',String((event.clientX-box.left)/box.width*2-1));scene.style.setProperty('--ry',String((event.clientY-box.top)/box.height*2-1));},{signal});
 const reset=()=>{scene?.style.setProperty('--rx','0');scene?.style.setProperty('--ry','0');scene?.style.setProperty('--scroll','0');};scene?.addEventListener('pointerleave',reset,{signal});reduced.addEventListener('change',reset,{signal});signal.addEventListener('abort',()=>cancelAnimationFrame(frame),{once:true});
 }
 disconnectedCallback(){this.cleanup?.abort();}
}
if(!customElements.get('moyo-stage'))customElements.define('moyo-stage',MoyoStage);
</script>

<style>
.experience{height:145svh;min-height:900px}.scene{position:sticky;top:0;height:100svh;min-height:660px;overflow:hidden;isolation:isolate;--scroll:0;--rx:0;--ry:0;background:radial-gradient(ellipse at 50% 45%,var(--panel),var(--paper) 70%)}.scene-glow{position:absolute;left:29%;top:28%;width:45%;height:55%;background:var(--moyo-accent);filter:blur(110px);opacity:.1;border-radius:50%;transform:translate(calc(var(--rx)*20px),calc(var(--ry)*20px));z-index:-1}.scene-grid{position:absolute;inset:10% 4% 6%;background:linear-gradient(90deg,transparent calc(50% - .5px),#f2f5fc08 50%,transparent calc(50% + .5px));border:1px solid #f2f5fc09;pointer-events:none}.scene-type{position:absolute;top:23%;left:50%;transform:translate(-50%,calc(var(--scroll)*-80px));font-size:clamp(130px,28vw,430px);line-height:1;letter-spacing:-.095em;font-weight:700;color:color-mix(in srgb,var(--ink) 8%,transparent);white-space:nowrap;user-select:none}.opening{position:absolute;z-index:8;left:7%;top:26%;pointer-events:none;transform:translateY(calc(var(--scroll)*-120px));opacity:calc(1 - var(--scroll)*.6)}.tiny{display:block;font-size:9px;letter-spacing:.18em;line-height:1.7}.opening>.tiny{color:var(--muted);margin-bottom:26px}h1{font-size:clamp(44px,6.4vw,94px);font-weight:400;letter-spacing:-.065em;line-height:1.05;margin:0;max-width:650px}h1 span{color:var(--ink)}.filmstage{position:absolute;inset:13% 0 15%;perspective:1400px;transform:translate(calc(var(--rx)*9px),calc(var(--ry)*9px - var(--scroll)*10px)) scale(calc(1 + var(--scroll)*.11));transition:transform .35s ease-out}.photo{position:absolute;display:block;overflow:hidden;width:40%;height:85%;left:46%;top:7%;padding:0;border:1px solid #f2f5fc55;border-radius:4px;background:#263442;box-shadow:0 30px 90px #0008;transform-style:preserve-3d;transition:transform .85s cubic-bezier(.22,.75,.15,1),filter .85s,opacity .85s}.photo :global(img){width:100%;height:100%;display:block;object-fit:cover;object-position:center;pointer-events:none;filter:saturate(.7)}.photo.front{transform:translateX(0) rotateY(calc(-12deg + var(--rx)*3deg)) rotateZ(-3deg);z-index:4}.photo.next{transform:translateX(46%) translateZ(-240px) rotateY(-27deg) rotateZ(7deg);filter:brightness(.48);z-index:2}.photo.previous{transform:translateX(-43%) translateZ(-320px) rotateY(27deg) rotateZ(-10deg);filter:brightness(.35);z-index:1}.photo.front:hover{border-color:var(--accent)}.photo-meta{position:absolute;inset:auto 0 0;display:flex;justify-content:space-between;gap:10px;padding:22px 16px 14px;background:linear-gradient(transparent,#0009);font-size:8px;letter-spacing:.1em;color:#fff;text-align:left}.scene-side{position:absolute;right:4%;top:42%;writing-mode:vertical-rl;display:flex;gap:18px;align-items:center;font-size:8px;letter-spacing:.18em;color:var(--muted)}.side-line{height:60px;border-left:1px solid #aebccc60}.scene-footer{position:absolute;left:7%;right:6%;bottom:7%;z-index:10;display:flex;align-items:flex-end;justify-content:space-between;gap:20px}.featured-link>.tiny{color:var(--muted);margin-bottom:10px}.featured-name{display:flex;align-items:center;gap:25px;font-size:26px;letter-spacing:-1px}.featured-name>span{font-size:20px;color:var(--accent)}.reel-controls{display:flex;align-items:center;gap:24px}.reel-controls button{border:1px solid #ffffff25;background:#ffffff05;width:42px;height:42px;border-radius:50%;font-size:19px;transition:background .2s}.reel-controls button:hover{background:var(--moyo-accent);color:#08090b}.counter{font-size:11px;font-variant-numeric:tabular-nums}.counter>span{color:var(--muted)}.scroll-link{font-size:8px;letter-spacing:.1em;display:flex;gap:20px;align-items:center}.scroll-link span{font-size:23px}.concept-label{position:absolute;bottom:16px;left:7%;color:var(--muted);font-size:7px;letter-spacing:.2em}
moyo-stage{display:block}.photo :global(picture){display:block;width:100%;height:100%}.featured-name{view-transition-name:none}
.opening::before{content:'';position:absolute;inset:-24px -30px;z-index:-1;background:linear-gradient(90deg,var(--paper) 75%,transparent);filter:blur(16px);opacity:.94}.reel-controls button{color:var(--ink);border-color:var(--line);background:var(--panel)}.reel-controls button:hover{background:var(--accent);color:var(--accent-ink)}.scene-glow{background:var(--accent)}
@media(max-width:760px){.experience{height:125svh;min-height:850px}.scene{min-height:690px}.scene-type{top:30%;font-size:35vw}.opening{left:7%;top:18%}.opening>.tiny{font-size:10px;margin-bottom:15px}h1{font-size:clamp(42px,10vw,70px)}.filmstage{inset:32% 0 18%}.photo{left:22%;width:57%;height:94%;top:0}.photo.front{transform:rotateY(-10deg) rotateZ(-3deg)}.photo.next{transform:translateX(48%) translateZ(-250px) rotateY(-30deg) rotateZ(8deg)}.photo.previous{transform:translateX(-48%) translateZ(-250px) rotateY(30deg) rotateZ(-8deg)}.photo-meta{padding:20px 10px 10px;font-size:9px}.photo-meta span:last-child{display:none}.scene-side{display:none}.scene-footer{bottom:7%;align-items:center}.featured-name{font-size:22px}.featured-link>.tiny{font-size:10px}.reel-controls{gap:13px}.reel-controls button{width:44px;height:44px}.scroll-link{display:none}}
@media(prefers-reduced-motion:reduce){.opening,.filmstage{transform:none!important;opacity:1!important}.scene-type{transform:translateX(-50%)!important}.experience{height:auto;min-height:0}.scene{position:relative}.photo,.filmstage{transition:none!important}}

</style>
